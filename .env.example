# Azure Cognitive Services - Speech (Free Tier F0)
# Create a Speech resource in the Azure portal and copy the key + region here.
# Free Tier (F0): 5 audio hours/month of Pronunciation Assessment + 0.5M chars TTS.
#
# REGION: use the datacenter closest to you. From Canada, 'canadacentral'
# (Toronto) is recommended. If Free F0 isn't offered there, use 'westus2'.
# Write it lowercase, no spaces: "Canada Central" -> canadacentral.
EXPO_PUBLIC_AZURE_SPEECH_KEY=your_azure_speech_key_here
EXPO_PUBLIC_AZURE_SPEECH_REGION=canadacentral
